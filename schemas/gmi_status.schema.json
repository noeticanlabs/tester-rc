{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CohBit GMI Status",
    "description": "Schema for the GMI Node commit verification status (GmiStatus).",
    "type": "object",
    "properties": {
        "block_height": {
            "type": "integer",
            "minimum": 0
        },
        "receipt_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]+$"
        },
        "hash_verified": {
            "type": "boolean",
            "description": "Receipt hash recomputation passed"
        },
        "signature_verified": {
            "type": "boolean",
            "description": "Cryptographic signature verified (v0.4: always false)"
        },
        "transition_admissible": {
            "type": "boolean",
            "description": "All consensus-level constraints satisfied"
        }
    },
    "required": [
        "block_height",
        "receipt_hash",
        "hash_verified",
        "signature_verified",
        "transition_admissible"
    ]
}