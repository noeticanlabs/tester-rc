// CohBit-Copilot v13.3 — Learning Governance
// Enforces the learning admission lifecycle defined in docs/learning_doctrine.md.
//
// Operating law:
//   Learning governance gates the admission of observed events into
//   acknowledged learning. It does not certify understanding, promote
//   evidence levels, close obligations, or rewrite history.
//
//   A learning event is admissible only when it is:
//     classified → cross-checked → persisted → comparable across runs
//     → bounded by evidence.
//
//   The governance module may record admission, record refusal,
//   and list admitted learning. It may not delete, modify, or
//   overrule existing memory.

import * as path from 'node:path';
import * as fs from 'node:fs/promises';
import * as crypto from 'node:crypto';

// ─── Types ─────────────────────────────────────────────────────

export type EvidenceLevel = 'none' | 'surface_detected' | 'corpus_extracted' | 'cross_run_stable' | 'verified';

export interface LearningEvent {
    eventId: string;
    classifiedBy: string;
    classificationTimestamp: string;
    crossCheckedAgainst: string | null;
    previousRunAt: string | null;
    evidenceLevel: EvidenceLevel;
    confidence: number;
    canonSafety: 'passed' | 'failed' | 'not_checked';
    limitations: string[];
    admissionStatus: 'admitted' | 'refused' | 'pending';
    refusalReason: string | null;
    storedAt: string;
}

export interface LearningStore {
    version: 'v13.3';
    lastUpdated: string;
    events: Record<string, LearningEvent>;
    admittedCount: number;
    refusedCount: number;
    pendingCount: number;
}

// ─── Store paths ───────────────────────────────────────────────

function storePath(): string {
    return path.join(process.cwd(), '.cohbit', 'learning_store.json');
}

async function loadStore(): Promise<LearningStore> {
    try {
        const raw = await fs.readFile(storePath(), 'utf-8');
        return JSON.parse(raw) as LearningStore;
    } catch {
        const empty: LearningStore = {
            version: 'v13.3',
            lastUpdated: new Date().toISOString(),
            events: {},
            admittedCount: 0,
            refusedCount: 0,
            pendingCount: 0,
        };
        return empty;
    }
}

async function saveStore(store: LearningStore): Promise<void> {
    store.lastUpdated = new Date().toISOString();
    await fs.mkdir(path.join(process.cwd(), '.cohbit'), { recursive: true });
    await fs.writeFile(storePath(), JSON.stringify(store, null, 2));
}

// ─── Admissibility Check ───────────────────────────────────────

export function isLearningAdmissible(event: Omit<LearningEvent, 'admissionStatus' | 'refusalReason' | 'storedAt'>): { admissible: boolean; reason?: string } {
    // 1. Classification required
    if (!event.classifiedBy || event.classifiedBy === 'unknown') {
        return { admissible: false, reason: 'Not classified by a known processor.' };
    }

    // 2. Evidence level must be at least surface_detected
    if (event.evidenceLevel === 'none') {
        return { admissible: false, reason: 'Evidence level is "none" — no learning claim permitted.' };
    }

    // 3. Confidence floor
    if (event.confidence < 1.0) {
        return { admissible: false, reason: `Confidence ${event.confidence} is below minimum threshold 1.0.` };
    }

    // 4. Canon safety required
    if (event.canonSafety !== 'passed') {
        return { admissible: false, reason: `Canon safety status is "${event.canonSafety}" — must be "passed".` };
    }

    // 5. Limitations must be stated
    if (event.limitations.length === 0) {
        return { admissible: false, reason: 'No limitations declared — every learning claim must state known weaknesses.' };
    }

    // 6. Cross-check preferred but not required for admission
    //    (admitted with 'pending' cross-check flag is acceptable)

    return { admissible: true };
}

// ─── Record Learning Event ─────────────────────────────────────

export async function recordLearningEvent(
    event: Omit<LearningEvent, 'eventId' | 'admissionStatus' | 'refusalReason' | 'storedAt'>,
): Promise<LearningEvent> {
    const store = await loadStore();

    const eventId = `LEARN_${crypto.randomBytes(6).toString('hex').toUpperCase()}`;
    const check = isLearningAdmissible(event);

    const storedAt = new Date().toISOString();

    const record: LearningEvent = {
        eventId,
        classifiedBy: event.classifiedBy,
        classificationTimestamp: event.classificationTimestamp,
        crossCheckedAgainst: event.crossCheckedAgainst,
        previousRunAt: event.previousRunAt,
        evidenceLevel: event.evidenceLevel,
        confidence: event.confidence,
        canonSafety: event.canonSafety,
        limitations: event.limitations,
        admissionStatus: check.admissible ? 'admitted' : 'refused',
        refusalReason: check.reason ?? null,
        storedAt,
    };

    store.events[eventId] = record;
    if (check.admissible) store.admittedCount += 1;
    else store.refusedCount += 1;

    await saveStore(store);
    return record;
}

// ─── Query ─────────────────────────────────────────────────────

export async function listAdmittedLearning(): Promise<LearningEvent[]> {
    const store = await loadStore();
    return Object.values(store.events).filter(e => e.admissionStatus === 'admitted');
}

export async function listRefusedLearning(): Promise<LearningEvent[]> {
    const store = await loadStore();
    return Object.values(store.events).filter(e => e.admissionStatus === 'refused');
}

export async function getLearningStoreSummary(): Promise<{
    totalEvents: number;
    admittedCount: number;
    refusedCount: number;
    pendingCount: number;
    lastUpdated: string;
}> {
    const store = await loadStore();
    return {
        totalEvents: Object.keys(store.events).length,
        admittedCount: store.admittedCount,
        refusedCount: store.refusedCount,
        pendingCount: store.pendingCount,
        lastUpdated: store.lastUpdated,
    };
}

// ─── Refuse Admission Explicitly ───────────────────────────────

export async function refuseAdmission(
    eventId: string,
    reason: string,
): Promise<LearningEvent | null> {
    const store = await loadStore();
    const event = store.events[eventId];
    if (!event) return null;

    event.admissionStatus = 'refused';
    event.refusalReason = reason;
    store.refusedCount += 1;
    if (event.admissionStatus === 'admitted') store.admittedCount = Math.max(0, store.admittedCount - 1);

    await saveStore(store);
    return event;
}